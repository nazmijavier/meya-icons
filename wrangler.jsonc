// Cloudflare Workers settings for icons.meyalab.com (worker.js says what runs where).
// Secrets (SESSION_SECRET, POLAR_ACCESS_TOKEN, PRO_GITHUB_TOKEN) are given to the Worker by the Deploy workflow
// (scripts/cloudflare.mjs); README.md lists them. The route for icons.meyalab.com is set by its cutover task, not
// here, so a deploy never touches it.
{
  "name": "meya-icons",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // node:crypto and Buffer for the session cookie; secrets and variables are also readable as process.env
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // only docs/ is published: the rest of the repository never is
    "directory": "./docs",
    // /pricing serves pricing.html, and /pricing.html redirects to /pricing
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  // Polar identifiers, not secrets: the organization, and the Pro product's License Keys benefit. PRO_ACCESS_CODES:
  // access codes that open Pro without Polar, as "label:sha256" pairs (only hashes, see api/_lib/access.js)
  "vars": {
    "POLAR_ORG_ID": "3ae81f50-c647-4fd2-89be-a68e8b4d22c6",
    "POLAR_PRO_BENEFIT_ID": "2c450b0a-477e-49fb-91cb-dbd408756d06",
    "PRO_ACCESS_CODES": "owner:8960ebad42a311bfdb1b5d1a2618929017de242661e34a52f62bbe32267223aa"
  },
  // keep variables added in the dashboard when a deploy runs
  "keep_vars": true,
  // the workers.dev address, which the Deploy workflow checks; no per-version addresses, so an old version (with
  // the secrets it was deployed with) is gone once a newer one is live
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
